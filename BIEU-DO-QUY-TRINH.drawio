<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram id="luo-chat-quy-trinh" name="Quy trinh LUO Chat"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="QUY TRÌNH GEN VIDEO BẰNG LUO CHAT: IMAGE TO IMAGE VÀ IMAGE TO VIDEO" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#111111;fillColor=none;strokeColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1500" height="32" as="geometry"/></mxCell><mxCell id="n3" value="Thử một video trước, sửa qua nhiều vòng, chỉ chạy hàng loạt khi bản thử đạt. Quy tắc nội dung áp dụng ở mọi bước." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1500" height="24" as="geometry"/></mxCell><mxCell id="n4" value="DẠNG 1: IMAGE TO IMAGE  (dựng bằng ảnh tĩnh Muse tạo + ffmpeg; video ra 24 giây)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontStyle=1;fillColor=#f4f8ff;strokeColor=#3b6fd4;dashed=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1760" height="365" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;1. Đầu vào&lt;/b&gt;&lt;br&gt;• Video mẫu (thư mục hoặc Google Sheet theo ngày)&lt;br&gt;• Số lượng biến thể, ngôn ngữ lời đọc&lt;br&gt;• Mã nhân vật V01 đến V18 (không dùng nhóm trẻ em)&lt;br&gt;• Ảnh before / after mẫu" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#dbe8ff;strokeColor=#3b6fd4;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="190" height="250" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;2. Phân tích video gốc&lt;/b&gt;&lt;br&gt;• Tách cảnh, đo thời lượng, xem contact sheet&lt;br&gt;• Đo nhịp quét before → after ở 10 khung/giây&lt;br&gt;• Nghe lời thoại (Whisper), tách nhạc nền (Demucs)&lt;br&gt;• Bỏ đoạn quay app của bên khác" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#ebe0ff;strokeColor=#7c4dcc;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="255" y="175" width="190" height="250" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;3. Viết spec.json&lt;/b&gt;&lt;br&gt;• Cấu trúc: ảnh đầu + cặp before → after&lt;br&gt;• Số cặp = phần đầu / chu kỳ cặp của gốc&lt;br&gt;• Chuyển cảnh, nhịp bám gốc&lt;br&gt;• Nhân vật: ảnh thư viện hoặc mô tả chữ&lt;br&gt;• Thử khô (ảnh giả): kiểm tra 24 giây" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#ebe0ff;strokeColor=#7c4dcc;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="470" y="175" width="190" height="250" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;4. Gen thử 1 video&lt;/b&gt;&lt;br&gt;• Chạy thật 1 video (1 đến vài biến thể)&lt;br&gt;• Người dùng xem, ghi góp ý&lt;br&gt;• Sửa spec, lệnh, nhân vật&lt;br&gt;• Gen lại phần cần đổi: F0 → F1 → … → Fn" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#ffe9cc;strokeColor=#d4850a;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="685" y="175" width="190" height="250" as="geometry"/></mxCell><mxCell id="n9" value="Đủ chất lượng để chạy hàng loạt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dd;strokeColor=#d4850a;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="905" y="230" width="175" height="120" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;5. Gen hàng loạt (Muse)&lt;/b&gt;&lt;br&gt;• Mỗi biến thể ~12 ảnh: ảnh before + ảnh after&lt;br&gt;• After = ảnh before + ảnh after mẫu (giữ danh tính, áp concept)&lt;br&gt;• Mỗi video 1 cuộc trò chuyện&lt;br&gt;• Nhiều video chạy chồng nhau (--overlap)&lt;br&gt;• Song song theo số tài khoản × 6" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#d6f5e6;strokeColor=#1b9462;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1135" y="175" width="190" height="250" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;6. Dựng bằng ffmpeg&lt;/b&gt;&lt;br&gt;• Ghép ảnh theo nhịp gốc&lt;br&gt;• Đoạn cuối CỐ ĐỊNH 6 giây: khung upload → loading → ảnh after&lt;br&gt;• Lời đọc mới + giữ nhạc nền gốc, không phụ đề&lt;br&gt;• Tổng 24 giây" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#d6f5e6;strokeColor=#1b9462;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1350" y="175" width="190" height="250" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;7. Kiểm tra và giao&lt;/b&gt;&lt;br&gt;• Đo độ dài, xem contact sheet&lt;br&gt;• Soi áo kín, không hở, không logo&lt;br&gt;• Biến thể hỏng: chạy lại riêng&lt;br&gt;• Lưu thư mục, (tải Drive nếu bật)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#d6f5e6;strokeColor=#1b9462;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1565" y="175" width="180" height="250" as="geometry"/></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="Đạt (Fn)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1b9462;fontSize=10;fontStyle=1;fontColor=#1b9462;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="Chưa đạt: sửa thêm một vòng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d0463c;fontSize=10;fontStyle=1;fontColor=#d0463c;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="992" y="137"/><mxPoint x="565" y="137"/></Array></mxGeometry></mxCell><mxCell id="n21" value="Số liệu đã đo: khoảng 82 giây mỗi biến thể (lô 100 biến thể, 6 việc song song); chạy chồng 3 video với mức song song 18: khoảng 30 giây mỗi biến thể (lô 30 biến thể)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="432" width="1700" height="20" as="geometry"/></mxCell><mxCell id="n22" value="DẠNG 2: IMAGE TO VIDEO  (đưa nguyên video cho Muse gen lại, đổi nhân vật, giữ cảnh gốc)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontStyle=1;fillColor=#f4fff9;strokeColor=#1b9462;dashed=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="485" width="1760" height="385" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;1. Đầu vào&lt;/b&gt;&lt;br&gt;• Thư mục chứa video&lt;br&gt;• Mã nhân vật (ảnh dùng làm hình tròn BEFORE)&lt;br&gt;• Số biến thể mỗi video&lt;br&gt;• Chạy thử: 1 video trước" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#dbe8ff;strokeColor=#3b6fd4;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="555" width="190" height="260" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;2. Chuẩn bị video&lt;/b&gt;&lt;br&gt;• Bỏ phần giới thiệu app (giữ N cảnh đầu)&lt;br&gt;• Cắt phần giữ lại làm video tham chiếu&lt;br&gt;• Chọn mã nhân vật đúng giới tính / độ tuổi chủ thể&lt;br&gt;• Bỏ video có trẻ em làm chủ thể" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#ebe0ff;strokeColor=#7c4dcc;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="255" y="555" width="190" height="260" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;3. Gửi Muse&lt;/b&gt;&lt;br&gt;• Mỗi biến thể 1 yêu cầu&lt;br&gt;• Đính kèm: nguyên video + ảnh nhân vật&lt;br&gt;• Lệnh: gen video tương tự, đổi nhân vật, giữ nguyên cảnh và thời lượng&lt;br&gt;• Mỗi video 1 cuộc trò chuyện" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#ffe9cc;strokeColor=#d4850a;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="470" y="555" width="190" height="260" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;4. Chờ và nối clip&lt;/b&gt;&lt;br&gt;• Muse chỉ tạo tối đa 10 giây mỗi clip&lt;br&gt;• API chờ Muse xong hẳn, lấy video cuối&lt;br&gt;• Đo độ dài video nhận được&lt;br&gt;• Ngắn hơn gốc: tự nhắn Muse nối clip cho đủ&lt;br&gt;• Mỗi yêu cầu ~4 đến 7 phút" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#ffe9cc;strokeColor=#d4850a;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="685" y="555" width="190" height="260" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;5. Hậu kỳ&lt;/b&gt;&lt;br&gt;• Ghép nhạc/âm thanh gốc, cắt đúng độ dài&lt;br&gt;• Dán hình tròn BEFORE xuyên suốt video&lt;br&gt;• Vị trí chọn tự động ở chỗ ít vướng nội dung&lt;br&gt;• Chuẩn hoá khung và 30 khung/giây" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#ebe0ff;strokeColor=#7c4dcc;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="555" width="190" height="260" as="geometry"/></mxCell><mxCell id="n28" value="Bản thử đạt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dd;strokeColor=#d4850a;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="625" width="175" height="120" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;6. Chạy hàng loạt&lt;/b&gt;&lt;br&gt;• N biến thể mỗi video, nhiều video&lt;br&gt;• Mỗi video 1 cuộc trò chuyện, chạy song song&lt;br&gt;• Giới hạn theo số tài khoản × 6&lt;br&gt;• Dùng --tag để không lấy lại kết quả cũ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#d6f5e6;strokeColor=#1b9462;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1350" y="555" width="190" height="260" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;7. Kiểm tra và giao&lt;/b&gt;&lt;br&gt;• Độ dài = video gốc&lt;br&gt;• Xem khung hình: nhân vật đổi, cảnh giữ đúng&lt;br&gt;• Soi mặt nhất quán, chữ lạ, hình tròn che mặt&lt;br&gt;• Giao thư mục kết quả" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#d6f5e6;strokeColor=#1b9462;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1565" y="555" width="180" height="260" as="geometry"/></mxCell><mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n27" target="n28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="Đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1b9462;fontSize=10;fontStyle=1;fontColor=#1b9462;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=10;fontStyle=1;fontColor=#555555;" edge="1" parent="1" source="n29" target="n30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="Chưa đạt: sửa lệnh / ảnh nhân vật, gen lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d0463c;fontSize=10;fontStyle=1;fontColor=#d0463c;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n28" target="n25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1207" y="830"/><mxPoint x="565" y="830"/></Array></mxGeometry></mxCell><mxCell id="n39" value="Hạn chế đã biết: Muse không giữ chữ/logo của video gốc; khuôn mặt có thể lệch giữa các cảnh; video gốc &gt; 10 giây phụ thuộc Muse nối clip nên cần kiểm tra độ dài từng file." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="843" width="1700" height="20" as="geometry"/></mxCell><mxCell id="n40" value="QUY TẮC NỘI DUNG (áp dụng ở mọi bước, ưu tiên cao nhất)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontStyle=1;fillColor=#fff1f0;strokeColor=#d0463c;dashed=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="895" width="1760" height="78" as="geometry"/></mxCell><mxCell id="n41" value="Nhân vật là người lớn hư cấu, ăn mặc đầy đủ, kín đáo  •  Không người nổi tiếng, không logo  •  Không trẻ em làm chủ thể  •  Không sao chép gương mặt người thật  •  Không dùng ảnh thật Pinterest / TikTok làm nguồn" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#8a2a22;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1700" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>